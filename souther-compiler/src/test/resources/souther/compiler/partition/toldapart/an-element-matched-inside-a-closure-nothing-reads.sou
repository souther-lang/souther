// A `match` on an element inside a closure whose answer nothing reads is told apart as one whose
// answer is read.
//
// What `List.all` answers here is bound and never used, and the closure is still run: a run takes
// its arms as it takes the arms of a `match` at the top whose answer is never used, which tells its
// position apart all the same. What is told apart is read off the ways runs take, and whether an
// answer is used afterwards is no part of that.
//
// told apart at n: 2 groups of 2
// told apart at xs[*]: 2 groups of 2
module example.elementmatchedunread

data North
data South
data Region = North | South

data Ok = { n: Int }

behavior judge : (n: Int, xs: List<Region>) -> Ok
    constructs Ok

let judge (n, xs) = {
    guard n > 0 else Ok { n = 0 }
    let unused = List.all(r -> match r with
        | North -> true
        | South -> false, xs)
    Ok { n = 2 }
}
