// A `match` inside a closure over a list tells apart what it matches, which need not be what the
// closure was handed.
//
// The closure is handed each element of `xs` as `x` and never looks at it: the `match` is on `f`.
// So the element is told apart nowhere, however the closure ranges over it.
//
// What the closure answers does not turn on the element, so `List.all` answers whether the list is
// empty or what the `match` answered. The guard on it reads `f` and how many `xs` holds, and no
// element; the reading of the input draws its line at the list's length, and no decision reads it
// into classes.
//
// told apart at f: 2 groups of 2
// told apart at List.length(xs): unread here
// told apart at xs[*]: untouched
module example.closurematchesanother

data Yes
data No
data Flag = Yes | No

data North
data South
data Region = North | South

data Ok = { n: Int }

behavior judge : (f: Flag, xs: List<Region>) -> Ok
    constructs Ok

let judge (f, xs) = {
    guard List.all(x -> match f with
        | Yes -> true
        | No -> false, xs) else Ok { n = 1 }
    Ok { n = 2 }
}
