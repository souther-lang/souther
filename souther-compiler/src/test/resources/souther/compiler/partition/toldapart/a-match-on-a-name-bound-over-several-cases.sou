// A `match` on a name bound over several cases is a decision about the position the name stands at.
//
// `b` is the value matched at `lead.reason`, narrowed to the two cases under BantFailure. That is
// a narrowing of the position to several of its cases and still the position, so the inner `match`
// is a fork about `lead.reason`: the outer arms tell BantFailure's two cases from DuplicateOf, and
// the inner ones tell the two apart.
//
// told apart at lead.reason: 3 groups of 3
module example.bound

data NoBudget
data NoNeed
data BantFailure = NoBudget | NoNeed
data DuplicateOf
data Reason = BantFailure | DuplicateOf

data Lead = { reason: Reason }
data Ok = { n: Int }

behavior judge : (lead: Lead) -> Ok
    constructs Ok

let judge (lead) =
    match lead.reason with
        | BantFailure as b ->
            match b with
                | NoBudget -> Ok { n = 1 }
                | NoNeed -> Ok { n = 2 }
        | DuplicateOf -> Ok { n = 3 }
