// 出荷モジュール。台帳への書き込みを注入で受け取り、composed な behavior がそれに依存する。
//
// 識別子を日本語で書くのはこのファイルの仕事のひとつ。ASCII の外にある名前は、字句・名前解決・
// 診断の描画・整形時の桁幅・生成クラス名の全部を通るので、英語だけのコーパスはそこを一度も踏まない。
module conformance.shipping exposing ( 送り状番号, 区分, 出荷指示, 出荷済み )

import conformance.catalog as Catalog ( Sku, Weight )
import Bool ( not )

data 送り状番号 = String
    invariant String.length(value) >= 1

data 区分 = 通常 | 速達 | 冷蔵

data 出荷指示 =
    { 番号: 送り状番号
    , 品目: List<Sku>
    , 重量: Weight
    , 区分: 区分
    , 受付日: Date
    , 締切: DateTime
    , 集荷時刻: Time
    , 記録時刻: Instant
    }

data 出荷済み =
    { 番号: 送り状番号
    , 発送日: Date
    , 送料: Int
    }

// 台帳は外にあるので実装は注入される。自分で作る側の case を constructs に書く。
behavior 台帳へ書く : (指示: 出荷指示) -> 出荷済み | 書けなかった

behavior 出荷する : (指示: 出荷指示) -> 出荷済み | 重量超過 | 書けなかった
    depends on 台帳へ書く

let 上限 = Weight(30000)

let 係数 (c: 区分): Int = match c with
    | 通常 -> 1
    | 速達 -> 2
    | 冷蔵 -> 3

// 冷蔵だけが持つ温度。呼ぶ側が冷蔵に絞ってから渡すので、残る二つの腕は到達しないと言い切る。
let 保管温度 (c: 区分): Int = match c with
    | 冷蔵 -> 5
    | 通常 -> unreachable "常温の指示は保管温度を訊かれる前に振り分けられている"
    | 速達 -> unreachable "速達も常温なので、同じところで振り分けられている"

let 急ぎか (指示: 出荷指示): Bool =
    if Date.daysBetween(指示.受付日, DateTime.toDate(指示.締切)) <= 1 then true else false

let 午前の集荷か (指示: 出荷指示): Bool = Time.hour(指示.集荷時刻) < 12

// 修飾した呼び出しと、import して裸で書く呼び出しの両方をここで通す。`not` は import してあるので
// 裸、`Bool.not` は修飾。どちらか一方しか書かないコーパスは、もう一方を一度も踏まない。
let 夜間割増 (指示: 出荷指示): Int = if Bool.not(午前の集荷か(指示)) then 2 else 1

let 送料 (指示: 出荷指示): Int =
    Int.multiply(係数(指示.区分), Int.multiply(夜間割増(指示), List.length(指示.品目)))

// 番号だけを取り出して重複を落とす。Set と Map をここで一度ずつ通す。
let 番号の集合 (指示たち: List<出荷指示>): Set<送り状番号> =
    Set.fromList(List.map(指示 -> 指示.番号, 指示たち))

let 番号ごとの送料 (指示たち: List<出荷指示>): Map<送り状番号, Int> =
    Map.fromList(List.map(指示 -> (指示.番号, 送料(指示)), 指示たち))

let 出荷する (指示, 台帳へ書く) = {
    guard 指示.重量 <= 上限 else 重量超過
    guard not(急ぎか(指示)) || 午前の集荷か(指示) else 重量超過
    match 台帳へ書く(指示) with
        | 書けなかった as 失敗 -> 失敗
        | 出荷済み as 結果    -> 結果
}

// 行が使う値。fake がこれらを名前で引き当てるので、行の側と同じものをここで一度だけ書く。
// companion は行だけを持つが、fake は module のファイルにしか書けないので値もこちらに置く。
let 基準の指示 = 出荷指示
    { 番号 = 送り状番号("s-1")
    , 品目 = [ Sku("a-1") ]
    , 重量 = Weight(500)
    , 区分 = 通常
    , 受付日 = Date("2026-08-10")
    , 締切 = DateTime("2026-08-18T09:00")
    , 集荷時刻 = Time("08:30")
    , 記録時刻 = Instant("2026-08-10T00:00:00Z")
    }

let 台帳が拒む指示 = 出荷指示 { ...基準の指示, 番号 = 送り状番号("s-9") }

let 書かれた = 出荷済み { 番号 = 送り状番号("s-1"), 発送日 = Date("2026-08-17"), 送料 = 1 }

// 台帳の代役。値等価の表で、既定は `_`。拒む側の入力を1つ持つので、composed な `出荷する` から
// `書けなかった` が出る経路が行で踏める。
fake 台帳へ書く
    | (台帳が拒む指示) -> 書けなかった
    | _                -> 書かれた
