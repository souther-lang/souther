module souther.datetime

// DateTime arithmetic (ADR-0028, [#stdlib-datetime]). `DateTime` is `java.time.LocalDateTime`, a
// local date-time with no zone — the boundary owns the zone ([#primitives]). Each `let` names a JVM
// operation the backend emits. Like Date arithmetic these are pure, so they belong in the domain.
//
// Argument order is F#/Elm ([#pipe]): the date-time operated on comes last. `minutesBetween(from,
// to)` counts whole minutes; `toDate` drops the time of day, yielding a `Date`.
let addMinutes (minutes: Int, dt: DateTime): DateTime = intrinsic "datetime.addMinutes"
let addHours (hours: Int, dt: DateTime): DateTime = intrinsic "datetime.addHours"
let addDays (days: Int, dt: DateTime): DateTime = intrinsic "datetime.addDays"
let minutesBetween (from: DateTime, to: DateTime): Int = intrinsic "datetime.minutesBetween"

// A `DateTime` is a `Date` and a `Time` ([#stdlib-date], [#stdlib-time]), and these three say so.
// `toDate` drops the time of day, `toTime` drops the day, and `fromDateAndTime` puts the two back:
//
//     DateTime.fromDateAndTime(DateTime.toDate(dt), DateTime.toTime(dt)) == dt
//
// `fromDateAndTime` cannot fail. Whatever could have been wrong about the parts was settled when the
// `Date` and the `Time` were built — that is where `NotADate` and `NotATime` are answered — so there
// is nothing left here to refuse and no case to write an arm for.
//
// The name is not `fromParts`, which the other two temporals use for the Ints they read. A
// `DateTime` comes apart two ways, into a date and a time or into six numbers, so `fromParts` would
// leave a reader to work out which one it takes. This one says.
let toDate (dt: DateTime): Date = intrinsic "datetime.toDate"
let toTime (dt: DateTime): Time = intrinsic "datetime.toTime"
let fromDateAndTime (d: Date, t: Time): DateTime = intrinsic "datetime.fromDateAndTime"
