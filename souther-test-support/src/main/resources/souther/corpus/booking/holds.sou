// A value built that its own rule rejects, which is what a report naming the clause it fails is
// written about.
module conformance.holds exposing ( Hold, placeHold )

data Hold = Int
    invariant value >= 1 && value <= 300

// A hold for a party that has chosen no seat yet, written as zero. Zero is not a seat: the
// invariant admits nothing below one, and this is the construction it rejects.
behavior placeHold : (party: Int) -> Hold
    constructs Hold

let placeHold (party) = Hold(0)
