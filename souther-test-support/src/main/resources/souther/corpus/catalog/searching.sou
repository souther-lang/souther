// A list searched for an element, written as a recursion and as a fold, and a tree searched for a
// node.
//
// A recursive helper is not expanded where it is called, so what decides on its answer is read off
// its body: a walk of the list by its head, which answers something exactly where some element it
// reaches meets what the step asks of it. The fold says the same with what it carries. Both behaviors
// decide the same thing about the same list, which is what this file is for. A search of a tree goes
// down every node's zones and answers by what some node it reaches meets, or what every node does.
module conformance.searching exposing
    ( Shelf, Restock, Fine, Zone, restockByRecursion, restockByFold, restockAnyZone
    , everyZoneStocked, restockAnyZoneWithoutALeafRow )

data Shelf = { counts: List<Int> }

data Restock

data Fine

// The first count below the floor, where there is one. Every element before it is at or above it, so
// the answer holds something exactly where some count is below.
partial let firstShort (counts: List<Int>): List<Int> =
    match List.get(0, counts) with
        | None -> []
        | Some count -> if count < 3 then [ count ] else firstShort(List.drop(1, counts))

behavior restockByRecursion : (shelf: Shelf) -> Restock | Fine
let restockByRecursion (shelf) =
    if List.isEmpty(firstShort(shelf.counts)) then Fine else Restock

example restockByRecursion
    | "a count below the floor is restocked" :
        (Shelf { counts = [ 5, 1, 0 ] }) -> Restock
    | "a shelf at the floor everywhere is fine" :
        (Shelf { counts = [ 3, 4 ] }) -> Fine
    | "an empty shelf is fine" :
        (Shelf { counts = [] }) -> Fine

// The same search as a fold: once something is found it is carried as it is.
behavior restockByFold : (shelf: Shelf) -> Restock | Fine
let restockByFold (shelf) = {
    let short = List.fold((found, count) ->
            if List.isEmpty(found) then (if count < 3 then [ count ] else []) else found,
        [], shelf.counts)
    if List.isEmpty(short) then Fine else Restock
}

example restockByFold
    | "a count below the floor is restocked" :
        (Shelf { counts = [ 5, 1, 0 ] }) -> Restock
    | "one short of the floor is short" :
        (Shelf { counts = [ 2 ] }) -> Restock
    | "a shelf at the floor everywhere is fine" :
        (Shelf { counts = [ 3, 4 ] }) -> Fine
    | "an empty shelf is fine" :
        (Shelf { counts = [] }) -> Fine

// A zone and the zones inside it, as deep as a warehouse is laid out.
data Zone = { count: Int, zones: List<Zone> }

// Whether some zone at or under this one is below the floor: this one, or one reached from a zone
// inside it.
let anyShort (zone: Zone): Bool =
    zone.count < 3 || List.any(inner -> anyShort(inner), zone.zones)

behavior restockAnyZone : (zone: Zone) -> Restock | Fine
let restockAnyZone (zone) = if anyShort(zone) then Restock else Fine

example restockAnyZone
    | "a zone below the floor is restocked" :
        (Zone { count = 1, zones = [] }) -> Restock
    | "a zone inside one below the floor is restocked" :
        (Zone { count = 5, zones = [ Zone { count = 0, zones = [] } ] }) -> Restock
    | "zones at the floor everywhere are fine" :
        (Zone { count = 3, zones = [ Zone { count = 4, zones = [] } ] }) -> Fine
    | "a zone at the floor with nothing inside it is fine" :
        (Zone { count = 3, zones = [] }) -> Fine

// Whether every zone at or under this one is at the floor.
let stocked (zone: Zone): Bool =
    zone.count >= 3 && List.all(inner -> stocked(inner), zone.zones)

behavior everyZoneStocked : (zone: Zone) -> Restock | Fine
let everyZoneStocked (zone) = if stocked(zone) then Fine else Restock

example everyZoneStocked
    | "zones at the floor everywhere are fine" :
        (Zone { count = 3, zones = [ Zone { count = 4, zones = [] } ] }) -> Fine
    | "a zone at the floor with nothing inside it is fine" :
        (Zone { count = 3, zones = [] }) -> Fine
    | "a zone inside one below the floor is restocked" :
        (Zone { count = 5, zones = [ Zone { count = 0, zones = [] } ] }) -> Restock
    | "a zone below the floor is restocked" :
        (Zone { count = 1, zones = [] }) -> Restock

// The search again, with no row that comes back empty at a zone with nothing inside it. Every other
// step of it has a row, so what the decision is short of is that one, and a row for it is what a
// person is offered.
behavior restockAnyZoneWithoutALeafRow : (zone: Zone) -> Restock | Fine
let restockAnyZoneWithoutALeafRow (zone) = if anyShort(zone) then Restock else Fine

example restockAnyZoneWithoutALeafRow
    | "a zone below the floor is restocked" :
        (Zone { count = 1, zones = [] }) -> Restock
    | "a zone inside one below the floor is restocked" :
        (Zone { count = 5, zones = [ Zone { count = 0, zones = [] } ] }) -> Restock
    | "zones at the floor everywhere are fine" :
        (Zone { count = 3, zones = [ Zone { count = 4, zones = [] } ] }) -> Fine
