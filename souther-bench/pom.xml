<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>souther-bench</artifactId>
    <name>Souther Compiler Benchmarks</name>

    <description>
        What the compiler costs, measured on a corpus this module carries. Four measurements, each
        answering a question the others cannot: what one compile costs from a cold JVM and in steady
        state, where that time goes by phase, what an edit costs once the store already holds the
        answers, and how the whole-workspace compile grows with the number of modules.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-compiler</artifactId>
        </dependency>
        <!-- souther-runtime is `provided` in souther-compiler. The benchmark needs it present: without
             it the generated classes will not load, every example row is skipped, and the measurement
             would report a compile that did half the work. Raoh is there for the same reason — a
             derived decoder is built on it. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>net.unit8.raoh</groupId>
            <artifactId>raoh</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Not called from here. This module is the last the reactor builds, and its tests read
             every module's compiled classes: to check that a generated class's name is assembled in
             one place only, and that nothing outside the reading makes or takes apart a reachability
             answer. Both walk the modules the root pom names and refuse a module they cannot read,
             so every one of them is named here — saying so as dependencies is what makes `-am`
             build them, and what makes the checks cover what they claim to whichever way the tree
             was built. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-fmt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-build-driver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-lsp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-cli</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Run it with `java -jar souther-bench/target/souther-bench.jar`. It is one self-contained
             jar so a measurement can be taken against a jar kept from an earlier revision, which is
             what comparing two revisions asks for. -->
        <finalName>souther-bench</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>souther.bench.Bench</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- A measurement tool, not a library; keep it out of the Central bundle. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <configuration>
                            <skipPublishing>true</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
