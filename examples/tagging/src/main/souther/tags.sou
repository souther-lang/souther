// A small issue tracker, and the showcase for the Set and Map stdlib modules plus Option
// destructuring. It grew out of a thinner "tag normalization" example: that string-editing core
// survives as normalizeLabels (split / trim / lowercase over souther.string), but where the old
// version only sorted to group duplicate tags, a Set now removes them outright.
//
// The features on show:
//   - Set<Label> as a data field (labels): the derived codec reads a JSON array and dedups it into a
//     Set; Set.fromList / insert / remove / intersect / toList / size drive the label operations.
//   - Map<Label, Int> as a behavior output (countByLabel): Map.upsert counts each label across a
//     board of issues (a String-backed newtype key is allowed as a map key).
//   - Some(Assignee(name)) destructuring: assigneeOf opens the optional assignee's newtype in one
//     match pattern (the outermost .value elided), with a None arm for the unassigned case.
//
// The behaviors are pure, so there is no `fake`. Set / Map / Option values have no literal syntax, so
// they cannot appear in `example` fixtures; correctness is checked by the JUnit smoke test, which
// decodes JSON (arrays -> Set, objects -> Map) and reads results back through the encoder.
//
// exposing is omitted, so every generated class is public — the smoke test references them by name.
module example.tagging
import String ( split, trim, lowercase )
import List ( map, filter, fold, distinct )

data IssueId  = String
    invariant String.length(value) >= 1
data Label    = String
    invariant String.length(value) >= 1
data Assignee = String
    invariant String.length(value) >= 1

// An issue carries a Set of labels (duplicates collapse) and an optional assignee.
data Issue =
    { id: IssueId
    , title: String
    , labels: Set<Label>
    , assignee: Assignee?
    }
// A board is just the issues; countByLabel folds over it.
data Board = { issues: List<Issue> }

// === normalizeLabels: raw text -> a deduplicated label set ===
// The string-editing heritage: split on comma, trim + lowercase each piece, drop empties, wrap each
// as a Label, then Set.fromList to remove duplicates. Empty input (or all-blank) has no labels.
data RawLabels = { text: String }
data LabelSet = { labels: Set<Label> }
data NoLabels

behavior normalizeLabels : (input: RawLabels) -> LabelSet | NoLabels
    constructs LabelSet, NoLabels, Label

// One raw string to the cleaned, non-empty label list (still a List here; the Set comes next).
let cleaned (text: String): List<Label> =
    text
        |> split(",")
        |> map(piece -> piece |> trim |> lowercase)
        |> filter(piece -> String.length(piece) >= 1)
        |> map(piece -> Label(piece))

let normalizeLabels (input) = {
    let labels = Set.fromList(cleaned(input.text))
    require Set.size(labels) >= 1 else NoLabels
    LabelSet { labels = labels }
}

// === addLabel / removeLabel: Set insert / remove on the labels field ===
// Constructor spread reuses every other field; only labels changes.
behavior addLabel : (issue: Issue, label: Label) -> Issue
    constructs Issue
let addLabel (issue, label) = Issue { ...issue, labels = Set.insert(label, issue.labels) }

behavior removeLabel : (issue: Issue, label: Label) -> Issue
    constructs Issue
let removeLabel (issue, label) = Issue { ...issue, labels = Set.remove(label, issue.labels) }

// === sharedLabels: the labels two issues have in common (Set intersection) ===
behavior sharedLabels : (a: Issue, b: Issue) -> LabelSet
    constructs LabelSet
let sharedLabels (a, b) = LabelSet { labels = Set.intersect(a.labels, b.labels) }

// === assigneeOf: open the optional assignee with a Some(Newtype) pattern ===
// Some's first written layer opens the element type directly, so Some(Assignee(name)) binds name to
// the bare String in one pattern; the None arm handles the unassigned issue.
data Assigned = { name: String }
data Unassigned

behavior assigneeOf : (issue: Issue) -> Assigned | Unassigned
    constructs Assigned, Unassigned
let assigneeOf (issue) =
    match issue.assignee with
        | Some(Assignee(name)) -> Assigned { name = name }
        | None -> Unassigned

// === countByLabel: how many issues carry each label (Map.fromList) ===
// Collect every label occurrence across the board as plain strings (Set.toList each issue's labels,
// unwrap to the text, concatenate), then for each distinct key pair it with its occurrence count and
// build the result with Map.fromList — a List<(String, Int)> of (key, count) tuples into a
// Map<String, Int>. The key is the label text (Label.value); a Map key is a String or String-backed
// newtype.
data LabelCounts = { counts: Map<String, Int> }

behavior countByLabel : (board: Board) -> LabelCounts
    constructs LabelCounts

// Every label occurrence on the board, as plain strings, with repeats.
let labelKeys (issues: List<Issue>): List<String> =
    fold((acc, issue) -> acc ++ map(l -> l.value, Set.toList(issue.labels)), [], issues)

// How many times a key occurs in the collected list.
let occurrences (keys: List<String>, key: String): Int =
    List.length(filter(k -> k == key, keys))

let countByLabel (board) = {
    let keys = labelKeys(board.issues)
    LabelCounts { counts = Map.fromList(map(k -> (k, occurrences(keys, k)), distinct(keys))) }
}
