// Consumption tax: a fourth Souther module in this project, compiled in the same run as cart,
// ordering and inventory, and importing cart's PricedCart the way the other two do.
//
// This is the one example that uses `Decimal`. The amounts stay `Int` — yen has no fractional unit,
// so making them Decimal would be a lie — and only the rate is a Decimal. A fraction appears for
// exactly as long as the rate is applied, and rounding it away is the domain decision this module
// exists to write down.
//
// What is on show:
//   - Int and Decimal do not mix in an operator. Applying a rate reads
//     `Decimal.fromInt(net) * rate.value`, so the conversion sits where the value stops being yen.
//     F# takes the same position (`n * 0.1m` does not compile; `decimal n * 0.1m` does).
//   - Coming back is `Decimal.toInt(tax, FLOOR)`: which way a fraction is dropped is a rule of the
//     business, so it is named at the call rather than defaulted (as `Decimal.divide(a, b, scale,
//     mode)` names its own).
//   - The rate is a Decimal newtype whose range is an invariant, enforced wherever it is built —
//     including on the way in from the database, where the rate is a NUMERIC column.
//   - Tax is rounded once per rate, not once per line. Rounding per line changes the total, and the
//     `example`s below pin that difference.
module example.tax
import List ( map, fold )
import example.cart ( Sku, LineItem, PricedCart )

// A rate is at least 0 and below 1. The `m` in `0.10m` marks a Decimal literal; Souther has no
// floating-point type.
data TaxRate = Decimal
    invariant value >= 0.0m && value < 1.0m

// The category is a sum of value-less cases. What an order carries is the category, not the rate:
// a rate is revised by law, the category it belongs to is not.
data StandardRate
data ReducedRate
data TaxCategory = StandardRate | ReducedRate

// The rate in force for a category. It is injected, not written here, for the same reason: the
// figure is administered outside the model (a NUMERIC column read by jOOQ at the boundary), while
// this module states what is done with it. The `example`s below fake it, so the arithmetic and the
// rounding are checked at compile time with no database involved.
behavior rateOf : (category: TaxCategory) -> TaxRate
    constructs TaxRate

// The breakdown. net / tax / gross are all yen; the rate is the only Decimal that leaves.
data TaxBreakdown =
    { net: Int
    , rate: TaxRate
    , tax: Int
    , gross: Int
    }

behavior taxFor : (order: PricedCart, category: TaxCategory) -> TaxBreakdown
    requires rateOf
    constructs TaxBreakdown

// The rate is applied to the order's net total once, and the fraction is dropped downwards.
let taxFor (order, category, rateOf) = {
    let rate = rateOf(category)
    let tax = Decimal.toInt(Decimal.fromInt(order.total) * rate.value, FLOOR)
    TaxBreakdown { net = order.total, rate = rate, tax = tax, gross = order.total + tax }
}

fake rateOf
    | (StandardRate) -> TaxRate(0.10m)
    | (ReducedRate)  -> TaxRate(0.08m)

example taxFor
    | "the standard rate is 10%, rounded down" :
        (PricedCart { items = [ LineItem { sku = Sku("apple"), quantity = 3, unitPrice = 105 } ],
            total = 315, highValue = false }, StandardRate)
        -> TaxBreakdown { net = 315, rate = TaxRate(0.10m), tax = 31, gross = 346 }
    | "the reduced rate is 8%" :
        (PricedCart { items = [ LineItem { sku = Sku("rice"), quantity = 2, unitPrice = 550 } ],
            total = 1100, highValue = false }, ReducedRate)
        -> TaxBreakdown { net = 1100, rate = TaxRate(0.08m), tax = 88, gross = 1188 }
    | "half a yen is dropped, not rounded up" :
        (PricedCart { items = [ LineItem { sku = Sku("pen"), quantity = 1, unitPrice = 105 } ],
            total = 105, highValue = false }, StandardRate)
        -> TaxBreakdown { net = 105, rate = TaxRate(0.10m), tax = 10, gross = 115 }

// === What rounding per line would give instead ===
// The same cart with the tax taken line by line and summed. An invoice may not be taxed this way,
// and pinning the difference means a later change that rounds per line fails its example rather than
// quietly shifting every total by a yen.
data PerLineTax = { tax: Int }

behavior taxRoundedPerLine : (order: PricedCart, category: TaxCategory) -> PerLineTax
    requires rateOf
    constructs PerLineTax

let lineTax (line: LineItem, rate: TaxRate): Int =
    Decimal.toInt(Decimal.fromInt(line.quantity * line.unitPrice) * rate.value, FLOOR)

let taxRoundedPerLine (order, category, rateOf) = {
    let rate = rateOf(category)
    PerLineTax { tax = fold((acc, x) -> acc + x, 0, map(line -> lineTax(line, rate), order.items)) }
}

// Three lines of 105 yen: taken together 315 × 0.10 = 31.5 → 31 yen; line by line 10.5 → 10 yen
// three times, which is 30.
example taxRoundedPerLine
    | "rounding per line loses a yen" :
        (PricedCart { items =
            [ LineItem { sku = Sku("pen"), quantity = 1, unitPrice = 105 }
            , LineItem { sku = Sku("note"), quantity = 1, unitPrice = 105 }
            , LineItem { sku = Sku("clip"), quantity = 1, unitPrice = 105 } ],
            total = 315, highValue = false }, StandardRate)
        -> PerLineTax { tax = 30 }
