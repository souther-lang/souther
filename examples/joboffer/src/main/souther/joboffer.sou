// クラウドソーシングの案件登録。直和が直和を抱え、その中にまた直和がある ── という深さのある
// データを、境界の decode とドメインの match の両方から検証する例。データベースは出てこない。
// 注入 behavior はひとつもなく、すべて純粋な behavior なので fake も要らない。
//
// 元ネタは kawasima/validation-modeling の doc/model/01_crowd.md（仕様DSL）と、その Java + Raoh 実装
// (raoh/src/main/java/com/example/raoh/joboffer)。あちらは decoder を手で書いて制約を decoder に
// 埋めている。Souther では制約は newtype の invariant に置き、decoder はそこから導出される
// ── どのフィールドがどの範囲かを一度だけ書く。
//
// 見どころ:
//   - 直和の入れ子: 依頼 -> プロジェクト依頼 -> 精算方式 -> 固定精算 -> 予算 -> 範囲予算。
//     判別デコーダが各段で "type" タグを読み、その途中のどこで壊れても Issues が壊れた場所の
//     パスを持って返る。
//   - enum は unit data の直和で書く（時間単価 / 依頼期間）。値を持たないケースなので
//     `data 時給1000円から1500円` の一行で済み、match で網羅性が検査される。
//   - 制約は decoder ではなく newtype の invariant。Java 版の long_().min(2).max(1023) は
//     `data 募集人数 = Int invariant value >= 2 && value <= 1023` になる。
//   - 共通項目は `...依頼ベース` の spread で持たせる。
module example.joboffer
import String ( length )

// === 依頼ベースの値 ===
data 依頼タイトル = String
    invariant length(value) >= 1 && length(value) <= 99
data 依頼詳細 = String
    invariant length(value) >= 1 && length(value) <= 999

// === 予算 ===
// 上限額 / 下限額 は同じ「金額」でも役割が違うので別の newtype にする。上限だけ 99,999,999 で
// 頭打ちなのは Java 版の decoder に合わせた。
data 予算下限 = Int
    invariant value >= 1
data 予算上限 = Int
    invariant value >= 1 && value <= 99999999

data 範囲予算 =
    { 下限: 予算下限
    , 上限: 予算上限
    }
data 上限予算 = { 上限: 予算上限 }
data 未定予算

data 予算 = 範囲予算 | 上限予算 | 未定予算

// === 時間単価・依頼期間（値を持たないケースの直和 = enum）===
data 時給700円から1000円
data 時給1000円から1500円
data 時給1500円から2000円
data 時給2000円から3000円
data 時給3000円から4000円
data 時給4000円から5000円
data 時給5000円以上

data 時間単価 = 時給700円から1000円
    | 時給1000円から1500円
    | 時給1500円から2000円
    | 時給2000円から3000円
    | 時給3000円から4000円
    | 時給4000円から5000円
    | 時給5000円以上

data 一週間以内
data 一週間から一ヶ月
data 一ヶ月から三ヶ月
data 三ヶ月から六ヶ月
data 六ヶ月以上

data 依頼期間 = 一週間以内
    | 一週間から一ヶ月
    | 一ヶ月から三ヶ月
    | 三ヶ月から六ヶ月
    | 六ヶ月以上

// === 精算方式 ===
data 募集人数 = Int
    invariant value >= 2 && value <= 1023
data 週の稼働時間 = Int
    invariant value >= 2 && value <= 159

data 固定精算 =
    { 人数: 募集人数
    , 予算枠: 予算
    }
data 時間精算 =
    { 人数: 募集人数
    , 単価: 時間単価
    , 稼働時間: 週の稼働時間
    , 期間: 依頼期間
    }

data 精算方式 = 固定精算 | 時間精算

// === 一人あたりの作業件数 ===
data 作業単価 = Int
    invariant value >= 6 && value <= 999999
data 作業件数 = Int
    invariant value >= 2 && value <= 999999
data 一人あたり上限 = Int
    invariant value >= 2 && value <= 2999

data 制限なし
data 制限あり = { 上限: 一人あたり上限 }

data 一人あたりの作業件数 = 制限なし | 制限あり

// === 契約金額 ===
// エコノミー〜プレミアムは料金プランなので値を持たない。カスタムだけ指値を持つ。
data 契約金額指値 = Int
    invariant value >= 1

data エコノミー
data ベーシック
data スタンダード
data プレミアム
data カスタム金額 = { 指値: 契約金額指値 }

data 契約金額 = エコノミー | ベーシック | スタンダード | プレミアム | カスタム金額

// === 依頼 ===
// 三種の依頼は共通項目を spread で取り込む。取り込んだフィールドも decoder から見れば
// ただのフィールドなので、JSON の形は「共通項目＋その依頼固有の項目」の平らな object になる。
data 依頼ベース =
    { タイトル: 依頼タイトル
    , 詳細: 依頼詳細
    , 応募期限: Date
    }

data プロジェクト依頼 =
    { ...依頼ベース
    , 精算: 精算方式
    }
data タスク依頼 =
    { ...依頼ベース
    , 単価: 作業単価
    , 件数: 作業件数
    , 一人あたり: 一人あたりの作業件数
    }
data コンペ依頼 =
    { ...依頼ベース
    , 金額: 契約金額
    }

data 依頼 = プロジェクト依頼 | タスク依頼 | コンペ依頼

// === 想定総額 ===
// 依頼を受け付ける前に「いくらの案件か」を見積もる。直和を三段降りるので、この behavior が
// このモデルの match の網羅性をいちばん強く効かせる。予算が未定のときだけ金額が出ない ──
// それを 0 円ではなく別のケースで返すのが Souther の書き方（Option を出力に書かない）。
data 総額 = Int
    invariant value >= 0
data 総額確定 = { 金額: 総額 }
data 総額未定

behavior 想定総額 : (依頼: 依頼) -> 総額確定 | 総額未定
    constructs 総額確定, 総額未定, 総額

// レンジで示された単価・期間は下限で見積もる（多く見せない）。unit data の直和なので、
// ケースを増やせばこの match が網羅漏れとしてコンパイル時に落ちる。
let 単価の下限 (単価: 時間単価): Int =
    match 単価 with
        | 時給700円から1000円   -> 700
        | 時給1000円から1500円  -> 1000
        | 時給1500円から2000円  -> 1500
        | 時給2000円から3000円  -> 2000
        | 時給3000円から4000円  -> 3000
        | 時給4000円から5000円  -> 4000
        | 時給5000円以上        -> 5000

let 期間の週数 (期間: 依頼期間): Int =
    match 期間 with
        | 一週間以内       -> 1
        | 一週間から一ヶ月 -> 1
        | 一ヶ月から三ヶ月 -> 4
        | 三ヶ月から六ヶ月 -> 13
        | 六ヶ月以上       -> 26

// 料金プランの定価。カスタムだけ指値をそのまま使う。
let プラン金額 (金額: 契約金額): Int =
    match 金額 with
        | エコノミー   -> 50000
        | ベーシック   -> 100000
        | スタンダード -> 200000
        | プレミアム   -> 500000
        | カスタム金額 { 指値 } -> 指値.value

let 精算の総額 (精算: 精算方式): 総額確定 | 総額未定 =
    match 精算 with
        | 固定精算 { 人数, 予算枠 } ->
            match 予算枠 with
                | 範囲予算 { 上限 } -> 総額確定 { 金額 = 総額(上限.value * 人数.value) }
                | 上限予算 { 上限 } -> 総額確定 { 金額 = 総額(上限.value * 人数.value) }
                | 未定予算          -> 総額未定
        | 時間精算 { 人数, 単価, 稼働時間, 期間 } ->
            総額確定 { 金額 = 総額(
                単価の下限(単価) * 稼働時間.value * 期間の週数(期間) * 人数.value) }

let 想定総額 (依頼) =
    match 依頼 with
        | プロジェクト依頼 { 精算 } -> 精算の総額(精算)
        | タスク依頼 { 単価, 件数 } -> 総額確定 { 金額 = 総額(単価.value * 件数.value) }
        | コンペ依頼 { 金額 }       -> 総額確定 { 金額 = 総額(プラン金額(金額)) }

example 想定総額
    | "固定精算は上限予算 × 募集人数" :
        (プロジェクト依頼 { タイトル = 依頼タイトル("ロゴ制作"), 詳細 = 依頼詳細("コーポレートロゴ一式"),
            応募期限 = Date("2026-08-01"),
            精算 = 固定精算 { 人数 = 募集人数(3), 予算枠 = 上限予算 { 上限 = 予算上限(50000) } } })
        -> 総額確定 { 金額 = 総額(150000) }
    | "予算が未定なら金額は出ない" :
        (プロジェクト依頼 { タイトル = 依頼タイトル("ロゴ制作"), 詳細 = 依頼詳細("コーポレートロゴ一式"),
            応募期限 = Date("2026-08-01"),
            精算 = 固定精算 { 人数 = 募集人数(3), 予算枠 = 未定予算 } })
        -> 総額未定
    | "時間精算は 単価下限 × 稼働時間 × 週数 × 人数" :
        (プロジェクト依頼 { タイトル = 依頼タイトル("運用支援"), 詳細 = 依頼詳細("週次の運用代行"),
            応募期限 = Date("2026-08-01"),
            精算 = 時間精算 { 人数 = 募集人数(2), 単価 = 時給1500円から2000円,
                稼働時間 = 週の稼働時間(10), 期間 = 一ヶ月から三ヶ月 } })
        -> 総額確定 { 金額 = 総額(120000) }
    | "タスク依頼は 作業単価 × 作業件数" :
        (タスク依頼 { タイトル = 依頼タイトル("文字起こし"), 詳細 = 依頼詳細("音声の書き起こし"),
            応募期限 = Date("2026-08-01"), 単価 = 作業単価(100), 件数 = 作業件数(500),
            一人あたり = 制限あり { 上限 = 一人あたり上限(50) } })
        -> 総額確定 { 金額 = 総額(50000) }
    | "コンペ依頼はプランの定価" :
        (コンペ依頼 { タイトル = 依頼タイトル("キャッチコピー"), 詳細 = 依頼詳細("新商品のコピー"),
            応募期限 = Date("2026-08-01"), 金額 = スタンダード })
        -> 総額確定 { 金額 = 総額(200000) }
    | "カスタム金額は指値がそのまま総額" :
        (コンペ依頼 { タイトル = 依頼タイトル("キャッチコピー"), 詳細 = 依頼詳細("新商品のコピー"),
            応募期限 = Date("2026-08-01"), 金額 = カスタム金額 { 指値 = 契約金額指値(330000) } })
        -> 総額確定 { 金額 = 総額(330000) }

// === 応募期限の検査 ===
// 仕様DSLでは「応募期限は依頼日時から14日後までの範囲の日付」。今日を外から受け取る入力にして
// 依頼日の代わりに使う ── 時計は外の世界なので、ドメインは受け取るだけにする。
data 掲載可
data 期限切れ = { 超過日数: Int }
data 期限が先すぎる = { 残り日数: Int }

behavior 応募期限を検査する : (依頼: 依頼, 今日: Date) -> 掲載可 | 期限切れ | 期限が先すぎる
    constructs 掲載可, 期限切れ, 期限が先すぎる

// 三種の依頼はどれも 依頼ベース を取り込んでいるが、直和の値からそのまま応募期限を読むことは
// できない（ケースごとに別の型）。共通項目もケースを開いて取り出す。
let 応募期限 (依頼: 依頼): Date =
    match 依頼 with
        | プロジェクト依頼 { 応募期限 } -> 応募期限
        | タスク依頼 { 応募期限 }       -> 応募期限
        | コンペ依頼 { 応募期限 }       -> 応募期限

let 応募期限を検査する (依頼, 今日) = {
    let 残り = Date.daysBetween(今日, 応募期限(依頼))
    require 残り >= 0 else 期限切れ { 超過日数 = 0 - 残り }
    require 残り <= 14 else 期限が先すぎる { 残り日数 = 残り }
    掲載可
}

example 応募期限を検査する
    | "14日以内なら掲載できる" :
        (コンペ依頼 { タイトル = 依頼タイトル("キャッチコピー"), 詳細 = 依頼詳細("新商品のコピー"),
            応募期限 = Date("2026-08-01"), 金額 = ベーシック }, Date("2026-07-25"))
        -> 掲載可
    | "当日はまだ掲載できる" :
        (コンペ依頼 { タイトル = 依頼タイトル("キャッチコピー"), 詳細 = 依頼詳細("新商品のコピー"),
            応募期限 = Date("2026-07-25"), 金額 = ベーシック }, Date("2026-07-25"))
        -> 掲載可
    | "過ぎていれば超過日数を返す" :
        (コンペ依頼 { タイトル = 依頼タイトル("キャッチコピー"), 詳細 = 依頼詳細("新商品のコピー"),
            応募期限 = Date("2026-07-20"), 金額 = ベーシック }, Date("2026-07-25"))
        -> 期限切れ { 超過日数 = 5 }
    | "14日より先は受け付けない" :
        (コンペ依頼 { タイトル = 依頼タイトル("キャッチコピー"), 詳細 = 依頼詳細("新商品のコピー"),
            応募期限 = Date("2026-08-31"), 金額 = ベーシック }, Date("2026-07-25"))
        -> 期限が先すぎる { 残り日数 = 37 }
