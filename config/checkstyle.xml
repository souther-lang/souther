<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  One rule, run by the pre-commit hook in .githooks and by nothing else.

  Unused imports are already an error in CI: the `lint` profile in the root pom raises Error
  Prone's RemoveUnusedImports to ERROR. That check needs `clean` and a full Error Prone run, which
  is half a minute a commit cannot pay, so a finding first reaches the author after the push. This
  file is the same rule asked of a parser instead of a compiler, cheaply enough to answer before
  the commit is written.

  processJavadoc is what keeps the two answers the same. Error Prone reads documentation, so an
  import only a {@link} mentions is used; Checkstyle does not read it unless asked, and unasked it
  would stop commits CI would have accepted.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
    </module>
</module>
