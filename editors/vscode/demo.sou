module demo

data 金額 = Int
    invariant value >= 0

data 申請 = { 額: 金額 }
data 承認 = { 額: 金額 }
data 却下 = { 理由: String }

behavior 判定 : (a: 申請) -> 承認 | 却下
    constructs 承認, 却下

let 判定 (a) = {
    require a.額.value <= 100 else 却下 { 理由 = "over" }
    承認 { 額 = a.額 }
}

example 判定
    | "上限内は承認" : (申請 { 額 = 金額(50) })  -> 却下
    | "超過は却下"   : (申請 { 額 = 金額(200) }) -> 却下 { 理由 = "over" }
