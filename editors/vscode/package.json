{
  "name": "souther",
  "displayName": "Souther",
  "description": "Souther language support: syntax highlighting and the language server.",
  "version": "0.1.0",
  "publisher": "wolfchief",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kawasima/souther.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/kawasima/souther/issues"
  },
  "homepage": "https://github.com/kawasima/souther#readme",
  "keywords": [
    "souther",
    "language server",
    "lsp",
    "sou"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').accessSync('server/souther-lsp.jar')\"",
    "package": "vsce package"
  },
  "activationEvents": [
    "onLanguage:souther"
  ],
  "contributes": {
    "languages": [
      {
        "id": "souther",
        "aliases": [
          "Souther"
        ],
        "extensions": [
          ".sou"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "souther",
        "scopeName": "source.souther",
        "path": "./syntaxes/souther.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Souther",
      "properties": {
        "souther.server.jar": {
          "type": "string",
          "default": "",
          "description": "Path to souther-lsp.jar. Defaults to server/souther-lsp.jar inside the extension."
        },
        "souther.server.java": {
          "type": "string",
          "default": "java",
          "description": "The java executable used to launch the language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
